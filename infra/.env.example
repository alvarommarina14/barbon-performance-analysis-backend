# Local video provider (ANALYSIS_VIDEO_PROVIDER=local).
#
# Compose reads this file with:  docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# The same values must be exported for the backend (./gradlew bootRun) — see the README.

# Shared secret tusd sends on its post-finish hook. Must match analysis.video.local.hook-secret.
TUSD_HOOK_SECRET=local-hook-secret

# Where tusd (in the container) reaches the backend for its post-finish hook. The default
# assumes the backend runs on the host at :8080. If tusd logs "connection refused" for the
# hook, set this to the machine's LAN address, e.g. http://192.168.1.50:8080/api/v1/webhooks/tusd
# TUSD_HOOK_URL=http://host.docker.internal:8080/api/v1/webhooks/tusd

# The dev machine's LAN address, so the upload and playback URLs the backend returns are
# reachable from a phone on the same Wi-Fi. Leave as localhost for an all-on-one-machine run.
#   Windows:  ipconfig   (IPv4 Address)
ANALYSIS_VIDEO_PUBLIC_URL=http://192.168.1.50:1080
ANALYSIS_VIDEO_S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000
